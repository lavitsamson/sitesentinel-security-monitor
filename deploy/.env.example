# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env on the
# server, fill in every value, and keep it readable by root only (chmod 600).
# Never commit deploy/.env.

# Public hostname. Its A/AAAA records must point at this server before the first
# start, so Caddy can obtain the Let's Encrypt certificate.
SITE_DOMAIN=sitesentinel.example.com

# Release to run: a tag published by .github/workflows/release.yml (without the "v").
SITESENTINEL_VERSION=1.0.0

# --- Secrets: generate each one, never reuse the development values -------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32 (exactly 32 bytes; encrypts webhook secrets at rest, so
# keep it: changing it makes existing webhook channels undeliverable)
ALERT_SECRET_KEY=
# openssl rand -hex 24 (bearer token for /api/v1/metrics)
METRICS_TOKEN=

# --- Email ------------------------------------------------------------------------
# A real SMTP relay; smtps:// for implicit TLS on 465.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=SiteSentinel <no-reply@sitesentinel.example.com>

# --- Optional -----------------------------------------------------------------------
# Checks processed in parallel by the worker.
# WORKER_CONCURRENCY=5
