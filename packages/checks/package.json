{
  "name": "@sitesentinel/checks",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free passive check implementations with injected dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./simulated": {
      "types": "./dist/simulated/index.d.ts",
      "default": "./dist/simulated/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@sitesentinel/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "jest": "30.5.2",
    "nock": "15.0.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@sitesentinel/shared": "workspace:*"
  }
}
