{
  "name": "@sitesentinel/db",
  "version": "0.1.0",
  "private": true,
  "description": "Mongoose models and connection helpers shared by the API and the workers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sitesentinel/shared": "workspace:*",
    "mongoose": "9.11.0"
  },
  "devDependencies": {
    "@sitesentinel/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "typescript": "6.0.3"
  }
}
