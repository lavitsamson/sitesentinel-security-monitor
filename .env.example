# Copy to .env and adjust. Never commit .env.
# Defaults below match docker-compose.yml for local development.

# --- Shared --------------------------------------------------------------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
MONGO_URL=mongodb://localhost:27017/sitesentinel
REDIS_URL=redis://localhost:6379

# --- API -----------------------------------------------------------------
API_PORT=4000
# The only browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173
# Maximum JSON request body size.
BODY_LIMIT=100kb
# Per-dependency timeout for the readiness probes (API /api/v1/health/ready,
# worker /health/ready on WORKER_METRICS_PORT).
READINESS_TIMEOUT_MS=2000
# Reverse proxies in front of the API (0 locally), so rate limits see the real client IP.
TRUST_PROXY=0

# --- Auth ----------------------------------------------------------------
# HMAC key for access tokens, at least 32 characters. Dev-only value below;
# generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Alerts --------------------------------------------------------------
# AES-256-GCM key (base64 of exactly 32 bytes) that encrypts webhook signing
# secrets at rest. The API and the worker must share it. Dev-only value below;
# generate a real one with: openssl rand -base64 32
ALERT_SECRET_KEY=ZGV2LW9ubHktYWxlcnQta2V5LWNoYW5nZS1tZS0zMiE=

# --- Operations ----------------------------------------------------------
# When set (16+ characters), GET /api/v1/metrics and the worker's /metrics
# require "Authorization: Bearer <token>". Leave unset locally.
# METRICS_TOKEN=
# Port of the worker's /metrics and /health/live|ready server (0 turns it off).
WORKER_METRICS_PORT=9464
# Bull Board at http://localhost:4000/admin/queues, mounted only when a password
# (16+ characters) is set; off in production unless BULL_BOARD_ENABLED=true.
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=dev-only-board-password
# BULL_BOARD_ENABLED=false

# --- Email ---------------------------------------------------------------
# Mailpit catches everything locally; view it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=SiteSentinel <no-reply@sitesentinel.local>

# --- Worker --------------------------------------------------------------
# Jobs processed in parallel per worker process.
WORKER_CONCURRENCY=5
# How long SIGTERM waits for in-flight jobs before forcing exit.
SHUTDOWN_TIMEOUT_MS=30000
# The worker also reads WEB_ORIGIN (links in emails), SMTP_URL, MAIL_FROM and
# READINESS_TIMEOUT_MS from above.

# --- Tests ---------------------------------------------------------------
# E2E only: the API and worker answer verification and checks from a simulated
# internet (state in Redis) instead of real DNS/HTTP/TLS. Refused in production.
# SIMULATED_NETWORK=false
# Redis for the worker's BullMQ integration tests (skipped when unset). Each run
# uses its own key prefix and cleans up after itself.
# TEST_REDIS_URL=redis://localhost:6379

# --- Web (Vite dev server) -----------------------------------------------
# Where the dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
