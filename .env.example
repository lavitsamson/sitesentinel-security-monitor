# Copy to .env and adjust. Never commit .env.
# Defaults below match docker-compose.yml for local development.

# --- Shared --------------------------------------------------------------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
MONGO_URL=mongodb://localhost:27017/sitesentinel
REDIS_URL=redis://localhost:6379

# --- API -----------------------------------------------------------------
API_PORT=4000
# The only browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173
# Maximum JSON request body size.
BODY_LIMIT=100kb
# Per-dependency timeout for GET /api/v1/health/ready.
READINESS_TIMEOUT_MS=2000
# Reverse proxies in front of the API (0 locally), so rate limits see the real client IP.
TRUST_PROXY=0

# --- Auth ----------------------------------------------------------------
# HMAC key for access tokens, at least 32 characters. Dev-only value below;
# generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Email ---------------------------------------------------------------
# Mailpit catches everything locally; view it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=SiteSentinel <no-reply@sitesentinel.local>

# --- Worker --------------------------------------------------------------
# Jobs processed in parallel per worker process.
WORKER_CONCURRENCY=5
# How long SIGTERM waits for in-flight jobs before forcing exit.
SHUTDOWN_TIMEOUT_MS=30000

# --- Web (Vite dev server) -----------------------------------------------
# Where the dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
