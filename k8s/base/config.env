NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000
WORKER_METRICS_PORT=9464
# One reverse proxy (the ingress controller) sits in front of the API.
TRUST_PROXY=1
BODY_LIMIT=100kb
READINESS_TIMEOUT_MS=2000
WORKER_CONCURRENCY=5
# Below the worker's terminationGracePeriodSeconds (45), so in-flight jobs finish first.
SHUTDOWN_TIMEOUT_MS=30000
WEB_ORIGIN=https://sitesentinel.example.com
MAIL_FROM=SiteSentinel <no-reply@sitesentinel.example.com>
