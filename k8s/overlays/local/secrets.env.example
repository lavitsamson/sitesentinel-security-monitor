# scripts/kind-up.sh writes secrets.env (gitignored) from this template on first run,
# filling the random values. Never commit secrets.env.
MONGO_URL=mongodb://mongo:27017/sitesentinel
REDIS_URL=redis://redis:6379
SMTP_URL=smtp://mailpit:1025
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32 (exactly 32 bytes)
ALERT_SECRET_KEY=
# openssl rand -hex 24 (Prometheus sends it as a bearer token)
METRICS_TOKEN=
