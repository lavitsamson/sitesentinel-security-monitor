{
  "name": "@sitesentinel/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SiteSentinel background workers and scheduler (BullMQ).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@sitesentinel/shared": "workspace:*",
    "ioredis": "6.0.0",
    "mongoose": "9.11.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sitesentinel/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
