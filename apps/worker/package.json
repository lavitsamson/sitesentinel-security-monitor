{
  "name": "@sitesentinel/worker",
  "version": "1.0.0",
  "private": true,
  "description": "SiteSentinel background workers and scheduler (BullMQ).",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js -c jest.int.config.js --runInBand"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "@sitesentinel/checks": "workspace:*",
    "@sitesentinel/db": "workspace:*",
    "@sitesentinel/shared": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "mongoose": "9.11.0",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@sitesentinel/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  }
}
