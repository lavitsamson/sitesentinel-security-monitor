{
  "name": "@sitesentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "SiteSentinel REST API (Express).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js -c jest.int.config.js --runInBand",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@bull-board/api": "9.10.4",
    "@bull-board/express": "9.10.4",
    "@prometheus-io/client": "0.16.1",
    "@sitesentinel/checks": "workspace:*",
    "@sitesentinel/db": "workspace:*",
    "@sitesentinel/shared": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "mongoose": "9.11.0",
    "nodemailer": "10.0.16",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@sitesentinel/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  }
}
